#!/usr/bin/env python3
import serial
import serial.tools.list_ports
import sys
import time

def find_pico():
    """Find any serial port that might be the Pico"""
    ports = serial.tools.list_ports.comports()
    
    # Try Pico vendor ID first
    for port in ports:
        if port.vid == 0x2E8A:
            return port.device
    
    # Try common ports
    import glob
    for pattern in ['/dev/ttyACM*', '/dev/tty.usbmodem*', '/dev/ｓcu.usbmodem*']:
        ports = glob.glob(pattern)
        if ports:
            return ports[0]
    
    return None

def send_number(number):
    port = find_pico()
    if not port:
        print("No Pico found!")
        return
    
    print(f"Sending {number} to {port}")
    
    try:
        # Ultra simple - just send the number and newline
        ser = serial.Serial(port, 115200, timeout=1)
        time.sleep(1)
        
        # Send number + newline
        data = f"{number}\n"
        ser.write(data.encode())
        ser.flush()
        
        print(f"Sent: {number}")
        ser.close()
        
    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 send.py <number>")
        sys.exit(1)
    
    try:
        num = int(sys.argv[1])
        send_number(num)
    except ValueError:
        print("Please provide a number")